{
  "hosting": {
    "public": "firebase-redirect",
    "redirects": [
      {
        "source": "/",
        "destination": "https://grindmeter-sand.vercel.app/",
        "type": 301
      },
      {
        "regex": "^/(?P<path>(?:[^_]|_[^_]).*)$",
        "destination": "https://grindmeter-sand.vercel.app/:path",
        "type": 301
      }
    ]
  }
}
